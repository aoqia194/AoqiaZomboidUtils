{
    "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
    "completion": {
        "autoRequireSeparator": "/"
    },
    "doc": {
        "privateName": ["_*"]
    },
    "diagnostics": {
        "disable": ["unnecessary-if"]
    },
    "runtime": {
        "requirePattern": ["shared/?.lua", "client/?.lua", "server/?.lua"],
        "version": "Lua5.1"
    },
    "workspace": {
        "ignoreDir": [".vscode", "assets", "Contents/mods/AoqiaZomboidUtils/media"],
        "library": ["$UMBRELLA_PATH"],
        "workspaceRoots": ["Contents/mods/AoqiaZomboidUtils/42/media/lua"]
    }
}
